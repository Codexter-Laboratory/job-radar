# Pick one provider. The classifier reads whichever key is present.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Free options, both use LLM_PROVIDER=openai:
#   Local Ollama (free, private): OPENAI_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  (no key needed)
#   Groq free tier:               OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_API_KEY=gsk_...  LLM_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=

# Optional model override. Defaults to gpt-4o-mini / claude-sonnet-4-5.
# LLM_MODEL=gpt-4o-mini

# Written into golden.jsonl so labels are attributable.
LABELLER=hassan

# Apply stage: SMTP for email applications and the daily report.
# Gmail: smtp.gmail.com, port 465, and an app password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
# SMTP_FROM=you@gmail.com
# Where the daily report goes. Defaults to the email in applicant.json.
# NOTIFY_EMAIL=you@gmail.com

# Overrides for config.json "apply"
# APPLY_DRY_RUN=false
# HEADLESS=false
